import funkin.modding.module.Module;
import funkin.graphics.FunkinSprite;
import funkin.ui.mainmenu.MainMenuState;
import funkin.ui.UIState;
import funkin.util.WindowUtil;
import flixel.FlxG;

class DiscordButton extends Module {
    final url = "https://discord.gg/khpuvUcGMz";

    function new() {
        super("SuperBotDiscordButton", 1);
    }

    function onStateChangeEnd(event) {
        if (event.targetState is MainMenuState) {
            var items = event.targetState.menuItems;

            var prevItems = [];
            for (i => item in items.members) {
                if (i < 4) continue;

                item.y += 160;
                items.remove(item);
                prevItems.push(item);
            }

            event.targetState.createMenuItem('discord', 'mainmenu/discord', () ->
            {
                event.targetState.uiStateMachine.transition(UIState.Idle);
                WindowUtil.openURL(url);
            });
            var menuItem = items.getItem('discord');
            menuItem.x = FlxG.width / 2;
            menuItem.y = items.members[3].y + 160;
            menuItem.scrollFactor.x = FlxG.onMobile ? 0.4 : 0;
            menuItem.scrollFactor.y = (items.members.length-1)/10;

            for (a in prevItems) items.add(a);
            for (a in items.members) a.scrollFactor.y += 0.1;

            event.targetState.bg.scrollFactor.y -= 0.02;
            event.targetState.magenta?.scrollFactor.y -= 0.02;
        }
    }
}